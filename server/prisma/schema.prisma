generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Regular customers. role=ADMIN grants admin-panel access to a customer account.
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  displayName      String?
  firstName        String?
  lastName         String?
  gender           Gender?
  dateOfBirth      DateTime?
  marketingConsent Boolean   @default(false)
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  giftCardRedemptions GiftCardRedemption[]
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
}

// Separate credential table for super-admin (Steven / back-office staff).
// Intentionally not merged with User — admins never appear in customer flows.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GiftCard {
  id             String         @id @default(cuid())
  code           String         @unique
  balance        Decimal        @db.Decimal(10, 2)
  initialBalance Decimal        @db.Decimal(10, 2)
  status         GiftCardStatus @default(ACTIVE)
  issuedTo       String?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions GiftCardRedemption[]
}

// No updatedAt — redemptions are intentionally immutable financial records.
model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  userId     String?
  amount     Decimal  @db.Decimal(10, 2)
  notes      String?
  redeemedAt DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

/// Homepage banners, uploaded and ordered by an administrator.
///
/// Steven manages these himself over time, so the artwork is data rather than
/// markup. Width and height are recorded at upload so next/image can reserve
/// the space and the carousel does not shift as it loads.
model Banner {
  id        String   @id @default(cuid())
  title     String
  filename  String   @unique
  linkUrl   String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  width     Int
  height    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

/// Resolved performer photographs, surviving a container restart.
///
/// node-cache is in memory, so a deploy empties it and every performer viewed
/// afterwards is fetched again. Against Ticketmaster's 5,000 calls/day that is
/// a real risk: two deploys on a busy day could exhaust the quota and degrade
/// the whole site to category gradients.
///
/// Hits only. A miss stays in memory on its 24-hour TTL, so a performer who
/// acquires a photograph next week is retried rather than written off for a
/// month.
model PerformerImageCache {
  name       String   @id
  source     String
  url        String
  width      Int
  height     Int
  sourcePage String
  title      String
  cachedAt   DateTime @default(now())

  @@index([cachedAt])
}

model CachedCategory {
  id         Int      @id
  name       String
  path       String   @unique
  parentPath String?
  data       Json
  cachedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CachedEvent {
  id          Int      @id
  name        String
  date        DateTime
  venueId     Int?
  performerId Int?
  data        Json
  cachedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CachedPerformer {
  id        Int      @id
  name      String
  data      Json
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CachedVenue {
  id        Int      @id
  name      String
  city      String?
  state     String?
  data      Json
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}
