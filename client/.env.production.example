# Production Hosting URL
NEXT_PUBLIC_APP_URL=https://ticketlove.net

# TicketNetwork MapWidget3 Website Config ID
# Maps WCID — 26809. Confirmed by TN Integration Support 2026-08-23; same in
# Sandbox and Production. This is NOT the CatalogAPI WCID (12498) — they differ.
NEXT_PUBLIC_MAPWIDGET_WEBSITE_CONFIG_ID=26809

# External Backend API URL (for server-side fetch inside docker network)
BACKEND_API_URL=http://api:8000

# Auth Secret — must match server JWT_SECRET
JWT_SECRET=replace-with-at-least-32-character-random-string

# Which Seatics deployment serves seat maps: sandbox | production.
# Must match the TicketNetwork catalog in TN_BASE_URL, NOT NODE_ENV.
# Production Seatics does not know sandbox event IDs and renders an empty map.
NEXT_PUBLIC_MAPWIDGET_ENV=sandbox
