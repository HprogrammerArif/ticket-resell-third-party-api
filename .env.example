# ==============================================================================
# TicketLove — Production Docker Environment Template
#
# On the VPS this file MUST be named exactly `.env` (not `.env.docker`):
#   Docker Compose reads `./.env` for BOTH `${VAR}` interpolation inside
#   docker-compose.yml AND for `env_file:` injection into containers.
#   `env_file:` alone does NOT feed `${VAR}` interpolation — naming it
#   anything else leaves POSTGRES_PASSWORD empty and the whole stack fails
#   to start.
#
# Setup:
#   cp .env.example /opt/ticketlove/.env
#   chmod 600 /opt/ticketlove/.env
#
# NEVER commit the real `.env`. This file holds placeholders only.
# ==============================================================================

# --- Database ---
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-generated-strong-db-password

# --- Authentication & Session Security ---
# Generate with: openssl rand -hex 32
# MUST BE IDENTICAL for both the api and web services.
JWT_SECRET=replace-with-at-least-32-character-random-secret
JWT_EXPIRES_IN=7d

# --- TicketNetwork Credentials ---
# Get these from the TN DevPortal (account ZX7910-STORE).
# NEVER paste real keys into this example file — it is committed to git.
TN_CONSUMER_KEY=replace-with-tn-consumer-key
TN_CONSUMER_SECRET=replace-with-tn-consumer-secret
TN_WCID=26809
TN_BASE_URL=https://www.tn-apis.com/catalog/v2
TN_TOKEN_URL=https://key-manager.tn-apis.com/oauth2/token
TN_REVOKE_URL=https://key-manager.tn-apis.com/oauth2/revoke

# --- Image Tag for Deployment ---
# CI overrides this per-deploy with the git SHA.
TAG=latest
